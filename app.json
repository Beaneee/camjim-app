{
  "expo": {
    "name": "캠짐",
    "slug": "camjim",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E3B43"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.camjim"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E3B43"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.camjim"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-media-library",
        {
          "photosPermission": "캠짐이 짐 포스터를 사진첩에 저장하려고 해요.",
          "savePhotosPermission": "캠짐이 짐 포스터를 사진첩에 저장하려고 해요.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ]
  }
}
